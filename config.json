{
    "directories": {
        "audit_dir": "audit files",
        "output_dir": "output files",
        "debug_dir": "debug",
        "config_file": "config.json"
    },
    "preprocessing": {
        "key_fields": [
            "description",
            "type",
            "cmd",
            "value",
            "file_path",
            "registry_key",
            "sql_query",
            "policy_name",
            "check_type",
            "systemvalue",
            "reg_key",
            "wmi_request",
            "info",
            "solution",
            "reference",
            "see_also"
        ]
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(levelname)s - %(message)s"
    },
    "output": {
        "output_format": [
            "xlsx",
            "html"
        ],
        "parallel_processing": true
    }
}